# MongoDB connection string (MongoDB Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, defaults to "handprints")
MONGODB_DB=handprints

# Your name as it appears on the site (e.g. "Rahim Sir")
NEXT_PUBLIC_TEACHER_NAME=Your Name

# Secret key to delete inappropriate handprints via the API (keep it secret)
ADMIN_KEY=change-me-to-something-long-and-random

